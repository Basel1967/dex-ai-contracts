{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:dex-ai:schema:event:event-envelope:1.0.0",
  "title":"DEX AI Event Envelope v1.0.0",
  "x-artifact-status":"Draft",
  "x-publication-status":"BLOCKED_P0",
  "type":"object",
  "additionalProperties":false,
  "required":["contract_name","contract_version","event_id","event_type","event_version","event_domain","event_stage","producer_name","producer_version","source_id","source_type","subject_ref","related_entity_refs","observed_at","ingested_at","available_at","ordering_key","ordering_position","idempotency_key","correlation_id","causation_event_id","trace_context","payload","payload_hash","raw_ref","verification_status","finality_status","provenance","quality_flags","schema_versions","data_classification","retention_class","integrity","admission_status","execution_mode","replay"],
  "properties":{
    "contract_name":{"const":"event-envelope"},"contract_version":{"const":"1.0.0"},
    "event_id":{"$ref":"#/$defs/eventId"},"event_type":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,63}$"},"event_version":{"$ref":"#/$defs/semver"},
    "event_domain":{"enum":["CHAIN","MARKET","SOCIAL","QUALITY","ANALYSIS","DECISION","SYSTEM"]},"event_stage":{"enum":["RAW","NORMALIZED","SYSTEM"]},
    "producer_name":{"$ref":"#/$defs/name"},"producer_version":{"$ref":"#/$defs/semver"},
    "source_id":{"type":"string","pattern":"^urn:dex-ai:source:[a-z0-9][a-z0-9.-]{1,62}$"},"source_type":{"enum":["SOLANA_RPC","SOLANA_GEYSER","SOLANA_WEBSOCKET","DEX_API","SOCIAL_API","INTERNAL","SYNTHETIC"]},
    "source_record_id":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9:._/-]+$"},
    "subject_ref":{"$ref":"#/$defs/entityRef"},"related_entity_refs":{"type":"array","items":{"$ref":"#/$defs/entityRef"},"maxItems":64,"uniqueItems":true},"token_case_id":{"type":"string","pattern":"^urn:dex-ai:token-case:(canonical|provisional):[0-9a-f]{32}$"},
    "event_time":{"$ref":"#/$defs/timestamp"},"observed_at":{"$ref":"#/$defs/timestamp"},"ingested_at":{"$ref":"#/$defs/timestamp"},"available_at":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
    "block_slot":{"type":"integer","minimum":0},"block_time":{"$ref":"#/$defs/timestamp"},"tx_signature":{"type":"string","pattern":"^[1-9A-HJ-NP-Za-km-z]{64,88}$"},"instruction_index":{"type":"integer","minimum":0,"maximum":65535},"inner_index":{"type":"integer","minimum":0,"maximum":65535},
    "ordering_key":{"type":"string","pattern":"^urn:dex-ai:ordering:[a-z0-9][a-z0-9:._-]{2,127}$"},"ordering_position":{"type":"string","pattern":"^(chain:[0-9]{1,20}:[1-9A-HJ-NP-Za-km-z]{64,88}:[0-9]{1,5}:[0-9]{1,5}|source:[0-9]{20}:[A-Za-z0-9._:-]{1,128})$"},
    "idempotency_key":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"correlation_id":{"type":"string","pattern":"^urn:dex-ai:correlation:[0-9a-f]{32}$"},"causation_event_id":{"oneOf":[{"$ref":"#/$defs/eventId"},{"type":"null"}]},
    "trace_context":{"$ref":"#/$defs/trace"},
    "payload":{"type":"object","minProperties":1,"maxProperties":128,"propertyNames":{"not":{"enum":["event_id","event_type","event_version","contract_name","contract_version","available_at","provenance","integrity","raw_ref"]}}},
    "payload_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"raw_ref":{"oneOf":[{"$ref":"#/$defs/rawRef"},{"type":"null"}]},
    "verification_status":{"enum":["UNVERIFIED","VERIFIED","FAILED"]},"finality_status":{"enum":["NOT_APPLICABLE","PROCESSED","CONFIRMED","FINALIZED","UNKNOWN"]},
    "provenance":{"$ref":"#/$defs/provenance"},"quality_flags":{"type":"array","uniqueItems":true,"maxItems":16,"items":{"enum":["LATE","OUT_OF_ORDER","DUPLICATE_DELIVERY","SOURCE_TIME_UNTRUSTED","RAW_EVIDENCE_UNAVAILABLE","PROVISIONAL_ID","CLOCK_SKEW_TOLERATED"]}},
    "schema_versions":{"type":"object","additionalProperties":false,"required":["envelope","payload"],"properties":{"envelope":{"const":"1.0.0"},"payload":{"$ref":"#/$defs/semver"},"normalizer":{"oneOf":[{"$ref":"#/$defs/semver"},{"type":"null"}]}}},
    "supersedes_event_id":{"$ref":"#/$defs/eventId"},"corrects_event_id":{"$ref":"#/$defs/eventId"},"revokes_event_id":{"$ref":"#/$defs/eventId"},
    "data_classification":{"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","UNCLASSIFIED"]},"retention_class":{"enum":["RAW_EVIDENCE_365D","EVENT_730D","DERIVED_365D","SECURITY_AUDIT_2555D"]},
    "integrity":{"$ref":"#/$defs/integrity"},"admission_status":{"enum":["STORED","QUARANTINED","VERIFIED","AVAILABLE","REJECTED"]},
    "quarantine_reasons":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["INVALID_IDENTIFIER","INVALID_TIMESTAMP","TIMESTAMP_ORDER","INTEGRITY_MISSING","INTEGRITY_MISMATCH","UNSUPPORTED_ALGORITHM","RAW_EVIDENCE_MISSING","RAW_EVIDENCE_UNAVAILABLE","UNCLASSIFIED_DATA","UNSUPPORTED_VERSION","CROSS_ENVIRONMENT_REFERENCE","INVALID_LINEAGE"]}},
    "execution_mode":{"enum":["LIVE","REPLAY"]},"replay":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/replay"}]}
  },
  "allOf":[
    {"if":{"properties":{"source_type":{"enum":["SOLANA_RPC","SOLANA_GEYSER","SOLANA_WEBSOCKET"]}}},"then":{"required":["block_slot","block_time","tx_signature","instruction_index","inner_index"]}},
    {"if":{"properties":{"event_stage":{"const":"RAW"}}},"then":{"properties":{"raw_ref":{"$ref":"#/$defs/rawRef"}}}},
    {"if":{"properties":{"event_stage":{"enum":["NORMALIZED","SYSTEM"]}}},"then":{"properties":{"causation_event_id":{"$ref":"#/$defs/eventId"}}}},
    {"if":{"properties":{"execution_mode":{"const":"LIVE"}}},"then":{"properties":{"replay":{"type":"null"}}},"else":{"properties":{"replay":{"$ref":"#/$defs/replay"}}}},
    {"if":{"properties":{"admission_status":{"const":"AVAILABLE"}}},"then":{"properties":{"available_at":{"$ref":"#/$defs/timestamp"},"verification_status":{"const":"VERIFIED"},"data_classification":{"not":{"const":"UNCLASSIFIED"}},"integrity":{"properties":{"status":{"const":"VERIFIED"}}}}}},
    {"if":{"properties":{"admission_status":{"const":"QUARANTINED"}}},"then":{"properties":{"available_at":{"type":"null"}},"required":["quarantine_reasons"]}},
    {"not":{"anyOf":[{"required":["supersedes_event_id","corrects_event_id"]},{"required":["supersedes_event_id","revokes_event_id"]},{"required":["corrects_event_id","revokes_event_id"]}]}}
  ],
  "$defs":{
    "semver":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"name":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
    "eventId":{"type":"string","pattern":"^urn:dex-ai:event:[0-9a-f]{32}$"},"entityRef":{"type":"string","pattern":"^urn:dex-ai:entity:(token|pool|wallet|social|token-case):(canonical|provisional):[A-Za-z0-9._-]{8,128}$"},
    "trace":{"type":"object","additionalProperties":false,"required":["trace_id","span_id","parent_span_id","trace_flags"],"properties":{"trace_id":{"type":"string","pattern":"^(?!0{32}$)[0-9a-f]{32}$"},"span_id":{"type":"string","pattern":"^(?!0{16}$)[0-9a-f]{16}$"},"parent_span_id":{"oneOf":[{"type":"string","pattern":"^(?!0{16}$)[0-9a-f]{16}$"},{"type":"null"}]},"trace_flags":{"type":"string","pattern":"^[0-9a-f]{2}$"},"trace_state":{"type":"string","minLength":1,"maxLength":512}}},
    "component":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"$ref":"#/$defs/name"},"version":{"$ref":"#/$defs/semver"}}},
    "rawRef":{"type":"object","additionalProperties":false,"required":["artifact_id","locator","content_hash","content_type","captured_at","environment","availability"],"properties":{"artifact_id":{"type":"string","pattern":"^urn:dex-ai:raw:[0-9a-f]{64}$"},"locator":{"type":"string","pattern":"^(s3|gs|az|ipfs)://[A-Za-z0-9._/-]{3,512}$","not":{"pattern":"(\\.\\.|[?&](token|sig|key|credential)=)"}},"content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"content_type":{"enum":["application/json","application/octet-stream"]},"captured_at":{"$ref":"#/$defs/timestamp"},"environment":{"enum":["development","test","staging","production"]},"availability":{"enum":["AVAILABLE","UNAVAILABLE","MISSING"]}}},
    "integrity":{"type":"object","additionalProperties":false,"required":["algorithm","canonicalization","encoding","scope","digest","status","verified_at"],"properties":{"algorithm":{"const":"SHA-256"},"canonicalization":{"const":"RFC8785-JCS-PROFILE"},"encoding":{"const":"UTF-8"},"scope":{"const":"payload"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"enum":["UNVERIFIED","VERIFIED","FAILED","MISSING","UNSUPPORTED"]},"verified_at":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["origin_kind","source_identity","collector","collection_method","observed_at","environment","transform_chain","parent_artifact_refs","replay_lineage"],"properties":{"origin_kind":{"enum":["ORIGINAL","NORMALIZED","DERIVED","CORRECTED","REPLAYED"]},"source_identity":{"type":"string","pattern":"^urn:dex-ai:source:[a-z0-9][a-z0-9.-]{1,62}$"},"collector":{"$ref":"#/$defs/component"},"collection_method":{"enum":["POLL","SUBSCRIPTION","WEBHOOK","REPLAY_READ","INTERNAL_EMIT"]},"observed_at":{"$ref":"#/$defs/timestamp"},"environment":{"enum":["development","test","staging","production"]},"normalizer":{"oneOf":[{"$ref":"#/$defs/component"},{"type":"null"}]},"transform_chain":{"type":"array","maxItems":32},"parent_artifact_refs":{"type":"array","maxItems":32,"uniqueItems":true},"replay_lineage":{"oneOf":[{"type":"string","pattern":"^urn:dex-ai:replay:[0-9a-f]{32}$"},{"type":"null"}]}}},
    "replay":{"type":"object","additionalProperties":false,"required":["replay_id","replay_run_id","cutoff_at","dataset_ref","snapshot_ref","source_artifact_versions","schema_versions","policy_versions","code_version","environment","seed"],"properties":{"replay_id":{"type":"string","pattern":"^urn:dex-ai:replay:[0-9a-f]{32}$"},"replay_run_id":{"type":"string","pattern":"^urn:dex-ai:replay-run:[0-9a-f]{32}$"},"cutoff_at":{"$ref":"#/$defs/timestamp"},"dataset_ref":{"type":"string","pattern":"^urn:dex-ai:dataset:[0-9a-f]{32}$"},"snapshot_ref":{"type":"string","pattern":"^urn:dex-ai:snapshot:[0-9a-f]{64}$"},"source_artifact_versions":{"type":"object","minProperties":1},"schema_versions":{"type":"object","minProperties":1},"policy_versions":{"type":"object","minProperties":1},"code_version":{"type":"string","pattern":"^git:[0-9a-f]{40}$"},"environment":{"enum":["development","test","staging"]},"seed":{"type":"integer","minimum":0,"maximum":4294967295}}}
  }
}
